rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /trainees/{traineeId} {
      // Authenticated trainer can do anything
      allow read, write: if request.auth != null;

      // Trainee (unauthenticated, accessed via URL) can read their own document
      allow get: if true;

      // Trainee can update only the workoutPlan field (mark workouts complete,
      // send feedback) and the traineePasswordHash field (change their password)
      allow update: if request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['workoutPlan', 'traineePasswordHash', 'updatedAt']);
    }

    match /groupPrograms/{programId} {
      // Authenticated trainer can do anything
      allow read, write: if request.auth != null;

      // Anyone can read a single group program document (to view it and register)
      allow get: if true;
    }

    match /groupMembers/{memberId} {
      // Authenticated trainer can read and write all member documents
      allow read, write: if request.auth != null;

      // Anyone can read a single member document (for member to view their plan)
      allow get: if true;

      // Anyone can create a new member document (self-registration)
      allow create: if true;

      // Members (unauthenticated) can only update workoutPlan and updatedAt
      allow update: if request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['workoutPlan', 'updatedAt']);
    }

    match /trainers/{trainerId} {
      // Only authenticated users (admin or sub-trainers) can read/write trainer documents
      allow read, write: if request.auth != null;
    }
  }
}
